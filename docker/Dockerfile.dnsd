FROM rust:1.77-slim AS builder
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /usr/src/app
COPY . .
RUN cargo build --release -p dnsd-bin

# Use minimal debian image with just libc
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/src/app/target/release/dnsd-bin /dnsd-bin
EXPOSE 6353/udp
ENTRYPOINT ["/dnsd-bin"]
