FROM rust:1.77-slim AS builder
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /usr/src/app
COPY . .
RUN cargo build --release -p feed_webhook-bin

FROM debian:bookworm-slim AS runtime
RUN useradd -m app
WORKDIR /app
COPY --from=builder /usr/src/app/target/release/feed_webhook-bin /app/
USER app
ENTRYPOINT ["/app/feed_webhook-bin"]
