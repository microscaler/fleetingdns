# FleetingDNS docker-compose environment contract.
#
# docker-compose.yml reads these via ${VAR:-default} interpolation. Every value
# has a dev default, so `docker compose up` works with no .env at all. Provide
# real values one of two ways:
#
#   Local (ms02): generate a decrypted .env from the SOPS profile —
#       just compose-env
#   CI: the octopilot sops-decrypt action exports the secret values into the
#       job environment before `docker compose` runs.
#
# .env is gitignored: never commit decrypted secrets.

# ── Non-secret config (application.properties) ─────────────────────────────
FDNS_DB_HOST=postgres
FDNS_DB_PORT=5432
FDNS_DB_USER=fdns
FDNS_DB_NAME=fdns
REDIS_URL=redis://redis:6379

# ── Secrets (application.secrets.env, SOPS-decrypted; placeholders here) ────
FDNS_DB_PASSWORD=fdns
DATABASE_URL=postgresql://fdns:fdns@postgres:5432/fdns
