# syntax=docker/dockerfile:1

FROM rust:1-alpine AS build
RUN apk add --no-cache musl-dev
WORKDIR /work
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY cmd cmd
RUN cargo install --path crates/bin/dnsd --locked

FROM scratch
COPY --from=build /usr/local/cargo/bin/dnsd /dnsd
EXPOSE 53/udp 53/tcp
ENTRYPOINT ["/dnsd", "--addr", "0.0.0.0:53"]
