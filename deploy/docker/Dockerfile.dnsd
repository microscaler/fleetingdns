# syntax=docker/dockerfile:1

# Build arguments for configurable values
ARG DNS_PORT=6353
ARG DNS_BIND_ADDR=0.0.0.0

FROM rust:1-alpine AS builder
RUN apk add --no-cache musl-dev
WORKDIR /work
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY cmd cmd
RUN cargo install --path crates/bin/dnsd --locked

FROM debian:bookworm-slim
RUN useradd -m app
WORKDIR /app
COPY --from=builder /usr/local/cargo/bin/dnsd /app/

# Set environment variables from build args
ENV DNS_PORT=${DNS_PORT}
ENV DNS_BIND_ADDR=${DNS_BIND_ADDR}

# Expose the configured port
EXPOSE ${DNS_PORT}/udp ${DNS_PORT}/tcp

# Create a startup script to handle environment variable expansion
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'exec /app/dnsd-bin --addr ${DNS_BIND_ADDR}:${DNS_PORT}' >> /app/start.sh && \
    chmod +x /app/start.sh

# Use the startup script
ENTRYPOINT ["/app/start.sh"]
